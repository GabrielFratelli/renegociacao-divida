{
  "name": "portal-renegociacao-dividas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node ./node_modules/@angular/cli/bin/ng.js serve",
    "build": "node ./node_modules/@angular/cli/bin/ng.js build",
    "lint": "eslint src scripts --max-warnings=0",
    "format": "prettier --write 'src/**/*.{ts,html,scss}' 'scripts/**/*.mjs' '*.{json,js}'",
    "format:check": "prettier --check 'src/**/*.{ts,html,scss}' 'scripts/**/*.mjs' '*.{json,js}'",
    "evidencias": "node scripts/gerar-evidencias.mjs",
    "test": "node ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node ./node_modules/jest/bin/jest.js --watch"
  },
  "dependencies": {
    "@angular/cdk": "^20.0.0",
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/material": "^20.0.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/router": "~20.3.0",
    "@fontsource/roboto": "^5.3.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "1.62.1",
    "@types/jest": "^30.0.0",
    "angular-eslint": "^20.3.0",
    "eslint": "^9.32.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-preset-angular": "^15.0.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.39.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  }
}
