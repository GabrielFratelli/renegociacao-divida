{
  "name": "bff-renegociacao-dividas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "node ./node_modules/typescript/bin/tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write 'src/**/*.ts' '*.{json,cjs}'",
    "format:check": "prettier --check 'src/**/*.ts' '*.{json,cjs}'",
    "test": "node ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node ./node_modules/jest/bin/jest.js --watch"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "eslint": "^9.32.0",
    "jest": "^30.0.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "tsx": "^4.19.4",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.39.0"
  }
}
